<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_notification_card"
    android:padding="12dp">

    <!-- Top Row: Badge, Subject, Time -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top">

        <!-- Accent Room Block -->
        <LinearLayout
            android:id="@+id/layout_room_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="76dp"
            android:maxWidth="100dp"
            android:minHeight="64dp"
            android:gravity="center"
            android:padding="8dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_room_badge"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_room_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="АУДИТОРИЯ"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#D0E8FF" />

            <TextView
                android:id="@+id/tv_room_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="84dp"
                android:layout_marginTop="2dp"
                android:text="313 КПА"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Right Column: Subject, Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_lesson_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ПРАКТИКА"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#90CAF9"
                    android:background="@drawable/bg_notification_type_badge"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />

                <TextView
                    android:id="@+id/tv_header_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="• Группа 26946"
                    android:textSize="11sp"
                    android:textColor="#B0BEC5" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_subject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="История России"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_lesson_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="2 пара • 10:50 - 12:25"
                android:textSize="12sp"
                android:textColor="#CFD8DC" />

            <TextView
                android:id="@+id/tv_tutor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Преп: Мамонтова Д.А."
                android:textSize="12sp"
                android:textColor="#B0BEC5"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Highlight: Status Bar & Chronometer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:padding="8dp"
        android:background="@drawable/bg_notification_type_badge"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_status_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="До конца пары:"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFB74D" />

        <Chronometer
            android:id="@+id/chronometer_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFD54F"
            android:visibility="visible" />

        <TextView
            android:id="@+id/tv_static_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Завтра в 09:00"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#81D4FA"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
