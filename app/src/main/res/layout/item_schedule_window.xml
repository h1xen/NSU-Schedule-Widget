<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_window_gap"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp">

    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_timer"
        app:tint="@color/accent_amber"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/tv_window_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:text="Окно между парами • 10:50 - 12:25"
        android:textColor="@color/accent_amber"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_window_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1 ч 35 мин"
        android:textColor="@color/dashboard_text_muted"
        android:textSize="11sp" />
</LinearLayout>
