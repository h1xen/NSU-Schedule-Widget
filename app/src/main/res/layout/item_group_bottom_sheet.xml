<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="3dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/layout_item_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_item_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="13dp">

        <!-- Radio indicator circle -->
        <View
            android:id="@+id/view_radio_indicator"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/bg_radio_unselected" />

        <!-- Title & Subtitle block -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_group_item_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/dashboard_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="26946" />

            <TextView
                android:id="@+id/tv_group_item_faculty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/dashboard_text_secondary"
                android:textSize="12sp"
                tools:text="Факультет информационных технологий" />
        </LinearLayout>

        <!-- Active Emerald Pill Badge -->
        <TextView
            android:id="@+id/tv_active_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_badge_emerald"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="АКТИВНА"
            android:textColor="@color/accent_emerald"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>
</FrameLayout>
