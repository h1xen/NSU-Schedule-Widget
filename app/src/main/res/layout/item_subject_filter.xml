<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="3dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/layout_subject_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_item_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_subject_filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            app:buttonTint="@color/accent_emerald" />

        <TextView
            android:id="@+id/tv_filter_subject_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:textColor="@color/dashboard_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Основы машинного обучения" />

    </LinearLayout>
</FrameLayout>
